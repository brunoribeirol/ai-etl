# Clerk (same application/instance as the backend's CLERK_SECRET_KEY —
# see ../.env.example and docs/adr/ADR-006-clerk-auth-supabase-postgres-tenancy.md).
# Publishable key only — safe to expose to the browser (NEXT_PUBLIC_ prefix),
# never the secret key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# The FastAPI backend (Sprint 6, ADR-011). Local dev: http://localhost:8000
# (make api, from the repo root). Production: the Railway API domain.
NEXT_PUBLIC_API_URL=http://localhost:8000
