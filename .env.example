# LLM Provider (Sprint 23, ADR-014) — escolha via AI_ETL_LLM_PROVIDER.
# Default: openai (comportamento inalterado se nada abaixo for tocado).
# AI_ETL_LLM_MODEL é lido pelo provedor ativo — seu significado muda conforme
# AI_ETL_LLM_PROVIDER (ver tabela de defaults por provedor no ADR-014).
# Nota: não há fallback automático entre provedores — fora de escopo (ADR-014 §4).
AI_ETL_LLM_PROVIDER=openai

# openai (default)
OPENAI_API_KEY=sk-...
AI_ETL_LLM_MODEL=gpt-4o-mini  # gpt-4o para o case study final

# anthropic — AI_ETL_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_ETL_LLM_MODEL=claude-sonnet-5

# google — AI_ETL_LLM_PROVIDER=google
# GOOGLE_API_KEY=...
# AI_ETL_LLM_MODEL=gemini-2.0-flash

# ollama — AI_ETL_LLM_PROVIDER=ollama (local, sem custo, sem API key)
# Instalar: brew install ollama && ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# AI_ETL_LLM_MODEL=llama3.1

# LLM provider circuit breaker (ADR-041) — both optional, safe defaults below.
# AI_ETL_LLM_CIRCUIT_FAILURE_THRESHOLD=5
# AI_ETL_LLM_CIRCUIT_COOLDOWN_SECONDS=60

# Banco de dados (cenários 2 e 3) — fonte/destino de pipeline do usuário
POSTGRES_URL=postgresql://ai_etl:ai_etl@localhost:5432/ai_etl_db

# Banco de dados de aplicação — audit trail (runs/analysis_runs) do próprio AI-ETL.
# Distinto de POSTGRES_URL acima. Suba com `make app-db-up` e migre com `make db-migrate`.
APP_DATABASE_URL=postgresql://ai_etl_app:ai_etl_app@localhost:5434/ai_etl_app_db

# Framework
AI_ETL_LOG_DIR=./runs
AI_ETL_MAX_RETRIES=3
AI_ETL_SANDBOX_TIMEOUT=30

# Async execution + rate limiting (Sprint 3, ADR-008) — broker/backend for
# Celery (see core/celery_app.py) and services/execution_queue.py's
# per-tenant fixed-window counters. Falls back to localhost:6379 if unset
# (matches docker-compose.yml's `redis` service), so this is optional for
# local dev unless you're overriding the default.
REDIS_URL=redis://localhost:6379/0
AI_ETL_RATE_LIMIT_MAX_RUNS=10
AI_ETL_RATE_LIMIT_WINDOW_SECONDS=3600

# Sprint 13 (ADR-016) — how often (seconds) the Celery beat process checks
# for due saved pipelines. Requires a separate `celery -A
# ai_etl.core.celery_app beat` process running (same image as the worker,
# different Custom Start Command) for scheduled pipelines to actually fire.
AI_ETL_SCHEDULER_INTERVAL_SECONDS=60

# Storage backend for ./runs/ artifacts (Sprint 4, ADR-009). Defaults to local
# disk (STORAGE_BACKEND unset) — no behavior change, nothing below required for
# local dev. Set STORAGE_BACKEND=s3 only in deployed environments (Railway):
# AWS_* are boto3's standard credential env vars (picked up automatically, no
# extra code); AI_ETL_S3_BUCKET is the single shared bucket; AI_ETL_ENV scopes
# the key prefix (dev|staging|prod, default dev) so environments/tenants never
# collide in that bucket.
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=sa-east-1
# AI_ETL_S3_BUCKET=
# AI_ETL_ENV=dev

# S3-Parquet warehouse destination (Sprint 20, ADR-021, destinations/s3_parquet_dest.py).
# A "s3_parquet"-type pipeline destination reuses the same AWS_* credential env
# vars above (boto3's default chain) — nothing new to set here if
# STORAGE_BACKEND=s3 is already configured. bucket/key are per-pipeline values
# from the plan itself (like csv's path or postgres's table), not env vars.

# Auth — Clerk (see docs/adr/ADR-006-clerk-auth-supabase-postgres-tenancy.md)
# Local JWT verification via JWKS; tenant_id is sourced from the verified Clerk user id.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Same Clerk Frontend API origin as CLERK_JWKS_URL above, but without the
# /.well-known/jwks.json suffix — PyJWT's `issuer` check compares this against
# the bare origin found in the verified JWT's `iss` claim.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# RBAC/org tenancy + tenant secrets (Sprint 19, ADR-021). tenant_id now
# prefers the active Clerk Organization id (JWT `o.id`/`org_id`) over the
# individual user id when the session has one — no extra env var needed for
# that, it comes from the same Clerk JWT above. AI_ETL_SECRETS_ENCRYPTION_KEY
# is a new, separate secret: the Fernet key used to encrypt every tenant's
# stored external-source credentials at rest (services/secrets_service.py).
# Generate once with `python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"` and never rotate it without a
# re-encryption migration for existing rows.
AI_ETL_SECRETS_ENCRYPTION_KEY=

# Platform-admin RBAC role (Sprint 31, ADR-032). Comma-separated Clerk
# individual user ids (the JWT `sub` claim, same id `ensure_user()` keys
# `users.id` by) granted cross-tenant `admin` access via `/admin/*`
# endpoints. Independent of any Clerk Organization role — a tenant's own
# org admin never gets this. Unset means the `admin` role is unreachable by
# anyone (fails closed), same precedent as AI_ETL_SECRETS_ENCRYPTION_KEY
# above.
# AI_ETL_PLATFORM_ADMINS=user_2abc123...,user_2xyz789...

# Observability — structured JSON logging + error tracking (Sprint 34, ADR-033).
# AI_ETL_LOG_LEVEL controls the root logger level for both the API and the
# Celery worker (core/logging_config.py); default INFO if unset.
# AI_ETL_LOG_LEVEL=INFO
#
# Sentry (core/observability.py) is fully optional, same "no key = no-op"
# convention as Resend/Slack/Teams/Google Chat above — unset SENTRY_DSN means
# error tracking is disabled and nothing else changes. Not verified against a
# real Sentry project in this repo (no account available) — see ADR-033.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# HTTP API for the Next.js frontend (Sprint 6, ADR-011). Comma-separated
# allowlist of origins allowed to call this API cross-origin (the Vercel
# frontend's domain(s)) — no default, an unconfigured deployment rejects every
# browser-origin request rather than silently allowing none or all. Not
# needed to run `make api` against `curl`/a non-browser client locally.
# API_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Additional source connectors (Sprint 11, ADR-012).
#
# SQLite (sources/sqlite_source.py) needs no env var — the `.db`/`.sqlite`
# file path is per-source in pipeline_plan.sources[].path, like csv_source.py.
#
# MySQL/MariaDB (sources/mysql_source.py) — single shared connection string,
# same convention as POSTGRES_URL. pymysql driver (mysql+pymysql://...),
# wire-compatible with MariaDB too.
# MYSQL_URL=mysql+pymysql://ai_etl:ai_etl@localhost:3306/ai_etl_db

# MongoDB (sources/mongodb_source.py) — single shared connection string;
# pipeline_plan.sources[].database/.collection pick the target per source
# (like MYSQL_URL/POSTGRES_URL's table/table-per-source pattern).
# MONGODB_URI=mongodb://localhost:27017

# REST auth (sources/rest_source.py) — pipeline_plan.sources[].auth never
# carries a literal secret, only the *name* of an env var (or, for OAuth2,
# an env var holding the client_id/client_secret) to read at call time (same
# convention as POSTGRES_URL above). Set whichever your pipeline's REST
# source(s) reference, e.g.:
# MY_API_KEY=...
# MY_API_TOKEN=...
# MY_API_USERNAME=...
# MY_API_PASSWORD=...
#
# OAuth2 client-credentials — token_url/scope live in pipeline_plan.sources[]
# itself (not secrets), only the client_id/client_secret are env-var-indirected:
# MY_OAUTH2_CLIENT_ID=...
# MY_OAUTH2_CLIENT_SECRET=...

# Drift alerts + digest delivery (Sprint 14, ADR-018). All four channels are
# fully optional and independent — a saved pipeline's drift check still runs
# and is logged with none configured, it just has nowhere to deliver the
# digest. Configure any subset; each is checked independently at send time.
# See services/notifications.py.
#
# Email (Resend, https://resend.com/docs/api-reference/emails/send-email):
# RESEND_API_KEY=re_...
# AI_ETL_ALERT_EMAIL_FROM=alerts@your-domain.com
# AI_ETL_ALERT_EMAIL_TO=owner@example.com,ops@example.com
#
# Slack (an Incoming Webhook URL, https://api.slack.com/messaging/webhooks):
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
#
# Microsoft Teams (a channel's "Workflows" webhook — Teams > channel > ⋯ >
# Workflows > "Post to a channel when a webhook request is received"; the
# older Office 365 Connector webhook is retired, this is the current path):
# TEAMS_WEBHOOK_URL=https://prod-00.eastus.logic.azure.com/workflows/...
#
# Google Chat (a space's Incoming Webhook — space name > Apps & integrations
# > Manage webhooks > create one; copy the full generated URL, including its
# ?key=...&token=... query string, which is the actual secret):
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAAA/messages?key=...&token=...
